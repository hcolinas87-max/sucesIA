# Configuración de la IA (opcional). Sin estos valores la app funciona igual, con reglas.
# En Streamlit Community Cloud: Settings > Secrets, y pega estas tres líneas con tus datos.
# En local: crea la carpeta .streamlit y guarda este archivo dentro con el nombre secrets.toml.
# NUNCA subas tu clave a GitHub.

LLM_PROVIDER = "openai"             # "openai" o "anthropic"
LLM_API_KEY  = "pega-aqui-tu-clave"
LLM_MODEL    = "nombre-del-modelo"  # consulta el nombre exacto en la documentación del proveedor
